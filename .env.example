# ── Network ──────────────────────────────────────────────────────────────────
# "base" for production, "baseSepolia" for testnet
NEXT_PUBLIC_CHAIN=base

# ── Contract addresses ────────────────────────────────────────────────────────
# Mainnet (v1.3 factory — do NOT use retired v1.2: 0x08BA5624107536d1CEA043B372978E7e9516E214)
NEXT_PUBLIC_FACTORY_ADDRESS=0x9E9C769aaCa509cD67Fbca2236dB26d8428a8027
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Base Sepolia testnet (override both above when NEXT_PUBLIC_CHAIN=baseSepolia)
# NEXT_PUBLIC_FACTORY_ADDRESS=<sepolia factory address>
# NEXT_PUBLIC_USDC_ADDRESS=0x036cbd53842c5426634e7929541ec2318f3dcf7e

# ── RPC / Keys ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_key_here
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id_here  # cloud.walletconnect.com
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key_here   # Coinbase Developer Platform

# ── Paymaster (Stage 2: Smart Wallet gas sponsorship) ────────────────────────
NEXT_PUBLIC_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base/your_paymaster_key

# ── Data ─────────────────────────────────────────────────────────────────────
# Published Google Sheet CSV (File → Share → Publish to web → CSV)
NEXT_PUBLIC_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://evensteven.bet
